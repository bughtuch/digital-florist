# ——————————————————————————————————————
# DIGITAL FLORIST — Environment Variables
# Copy to .env.local and fill in real values.
# Never commit .env.local or any secret values.
# ——————————————————————————————————————

# Supabase — public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server-only (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Stripe — public publishable key (safe to expose to browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe — server-only secret keys (NEVER prefix with NEXT_PUBLIC_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Site URL — used to construct Stripe return_url
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Stripe Tax — set to true only after configuring Automatic Tax in Stripe Dashboard
# The fixed $25 customer price is always inclusive of any tax
STRIPE_AUTOMATIC_TAX_ENABLED=false

# Reveal dev preview — development only, never commit a real value
# Set to any random string in .env.local to enable /api/dev/reveal-preview
# Not used in production
REVEAL_DEV_SECRET=

# ——————————————————————————————————————
# Build 09 — Delivery Engine
# ——————————————————————————————————————

# Resend — server-only transactional email (NEVER prefix with NEXT_PUBLIC_)
# Obtain from resend.com dashboard after configuring your sending domain
RESEND_API_KEY=

# Sender address — format: Digital Florist <hello@yourdomain.com>
# Must match a verified sending domain in your Resend account
EMAIL_FROM=

# Reply-to address — separate from sender; avoid no-reply for House brand
# Optional — leave blank to omit Reply-To header
EMAIL_REPLY_TO=

# Reveal token secret — server-only HMAC key for deterministic token derivation
# Must be at least 32 characters of strong random entropy
# Generate with: openssl rand -base64 48
# NEVER prefix with NEXT_PUBLIC_ — this must never reach the browser
# NEVER rotate without a coordinated token migration — existing URLs become invalid
REVEAL_TOKEN_SECRET=
