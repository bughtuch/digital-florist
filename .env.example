# ——————————————————————————————————————
# DIGITAL FLORIST — Environment Variables
# Copy to .env.local and fill in real values.
# Never commit .env.local or any secret values.
# ——————————————————————————————————————

# Supabase — public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server-only (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Stripe — public publishable key (safe to expose to browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe — server-only secret keys (NEVER prefix with NEXT_PUBLIC_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Site URL — used to construct Stripe return_url
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Stripe Tax — set to true only after configuring Automatic Tax in Stripe Dashboard
# The fixed $25 customer price is always inclusive of any tax
STRIPE_AUTOMATIC_TAX_ENABLED=false

# Reveal dev preview — development only, never commit a real value
# Set to any random string in .env.local to enable /api/dev/reveal-preview
# Not used in production
REVEAL_DEV_SECRET=
